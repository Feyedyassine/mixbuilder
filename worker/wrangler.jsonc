{
  // Share-links API for mixbuilder (see worker/src/index.ts). Deploy: npm run worker:deploy
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mixbuilder-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mixbuilder",
      "database_id": "2436d835-7ca1-4ad7-a37c-4fd86232360a",
      "migrations_dir": "migrations",
    },
  ],
  // Per-IP cap on creating links (reads are not limited).
  "ratelimits": [
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
